# Variables sensibles — NE JAMAIS committer
.env

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Python report generator build artifacts
python-reports/dist/
python-reports/build/
python-reports/*.spec
python-reports/__pycache__/
python-reports/reports/__pycache__/

# Logs applicatifs
logs/
*.log

# Sauvegardes
backup/

# OS
.DS_Store
Thumbs.db
.agents/